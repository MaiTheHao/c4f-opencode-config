{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "mcp": {
    "retrieval": {
      "type": "local",
      "command": [
        "python3",
        "{env:HOME}/.config/opencode/mcps/retrieval/retrieval_mcp.py"
      ],
      "environment": {
        "RETRIEVAL_CONTEXT_ROOT": "{env:HOME}/.config/opencode/local/agents/retrieval_agent"
      },
      "enabled": true
    }
  }
}